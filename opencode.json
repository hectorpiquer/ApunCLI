{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "PYTHONPATH=src python3 -m apuncli*": "allow",
      "python3 -m apuncli*": "allow",
      "python3 -m pytest*": "allow",
      "python3 -m unittest*": "allow",
      "*": "ask"
    },
    "read": "allow"
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    }
  }
}
